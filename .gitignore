# Local Python and editor state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.idea/
.vscode/

# Archive staging is deliberately outside the project, but keep any accidental
# local archive copies out of Git as well.
*.tar
*.tar.part-*
SHA256SUMS
